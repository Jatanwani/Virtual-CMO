{
  "name": "virtual-cmo-gateway",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "build:worker": "echo 'wrangler handles TS compilation'",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv namespace create CMO_CACHE",
    "kv:list": "wrangler kv namespace list",
    "secrets:set": "bash ./set-secrets.sh",
    "status": "curl https://virtual-cmo-gateway.YOUR_SUBDOMAIN.workers.dev/status"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.90.0"
  }
}
